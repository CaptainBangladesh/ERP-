# Copy to backend/.env.
#
# These defaults match the disposable PostgreSQL container in docker-compose.yml at the
# repo root — run `npm run db:up` and they work as-is. Port 55432 leaves any PostgreSQL
# already installed on your machine untouched.
#
# The development database and the test database MUST be different. The test harness
# truncates every table between tests, so pointing DATABASE_URL and TEST_DATABASE_URL at
# the same database will wipe your development data every time you run the suite.

DATABASE_URL="postgresql://erp:erp_local_dev@localhost:55432/erp_dev?schema=public"
# DIRECT_URL is required when using connection poolers (e.g. Supabase PgBouncer/Supavisor on port 6543) for Prisma migrations (port 5432)
DIRECT_URL="postgresql://erp:erp_local_dev@localhost:55432/erp_dev?schema=public"
TEST_DATABASE_URL="postgresql://erp:erp_local_dev@localhost:55432/erp_test?schema=public"

PORT=3000

# Allowed CORS origins for production when backend and frontend are hosted separately.
# Example: CORS_ORIGIN="https://your-app.vercel.app"
CORS_ORIGIN=""

# Signs every session token. Must be at least 32 characters and secret to the deployment.
#
# This value is fine for local development and for CI, and is worthless anywhere else —
# it is committed to the repository, so anyone can forge a token with it. Generate a real
# one per deployment:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# There is no default in code on purpose. A default would mean every deployment that
# forgot to set this shared one publicly-known signing key.
SESSION_SECRET="local-development-only-not-a-secret-0123456789abcdef"

# Signing in with Google. Both are read from the Google Cloud project's OAuth client; there
# are no fallbacks in the code, so an unset pair makes the Google button answer "not
# configured" rather than authenticate against somebody else's project.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must be registered in that project as an authorised redirect URI, character for character.
# Defaults to http://localhost:<PORT>/api/auth/google/callback when unset.
GOOGLE_AUTH_REDIRECT_URI=""
# The separate callback the CRM mailbox connection uses. A different route, so a different
# setting — one value could only ever point at one of the two flows.
GOOGLE_REDIRECT_URI=""

# The deployment's own outgoing mail - the fallback for a company that has not set its own
# on the Company mail screen, and the only mail available outside company scope (password
# reset runs for somebody who is not signed in, so there is no company to read settings for).
#
# Left empty on purpose: with no SMTP_HOST the server logs messages in development and
# refuses to send in production, rather than reporting success it has no basis for. A real
# host here would make a fresh clone try to send through somebody else's server.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# This API's own public address, used for links that have to work from outside it — today the
# open-tracking pixel in outgoing mail. Render sets RENDER_EXTERNAL_URL itself, so a Render
# deployment needs nothing here. Unset everywhere, the pixel is left out of production mail
# rather than pointed at localhost: sends still work, opens are simply never recorded.
PUBLIC_API_URL=""

# Encrypts stored SMTP passwords. Falls back to SESSION_SECRET when unset.
#
# Every server sharing this database must hold the SAME value. A mailbox configured on a
# laptop and read by a hosted server with a different secret cannot be decrypted — the send
# fails with "the stored password could not be read on this server", which is a key mismatch
# and not a wrong password. Changing it makes existing mailboxes unreadable until reconnected.
MAILBOX_SECRET=""

# Sending mail over HTTPS instead of a direct SMTP connection.
#
# Hosting platforms commonly block outbound SMTP — Render blocks ports 25, 465 and 587 on free
# web services — and a blocked port hangs rather than refusing, so every send dies with a
# connection timeout no mailbox change can fix. With SMTP_RELAY_URL set, mail goes to the
# serverless relay in `api/smtp-relay.mjs` over port 443 and that relay opens the SMTP
# connection from somewhere permitted. Mail still leaves through the company's own account.
#
# Must be the FULL path, e.g. https://your-project.vercel.app/api/smtp-relay
# See docs/deployment/hosted-email.md.
SMTP_RELAY_URL=""
# Shared with the relay so only this API can drive it. The relay refuses every request when it
# has neither this nor SESSION_SECRET set, rather than serving whoever finds the URL.
SMTP_RELAY_SECRET=""

# An alternative HTTPS transport, used only when no relay is configured. Resend refuses any
# sender on a domain not verified in its dashboard, so it fits a company sending from a domain
# it owns and cannot send from a plain Gmail or Outlook address.
RESEND_API_KEY=""

# Reading replies back into the CRM (the inbound half of email).
#
# An external scheduler POSTs /api/crm/mailboxes/poll every few minutes; the server reads the
# company mailbox over IMAP and records each reply on the lead it answers. That endpoint is
# public (a scheduler holds no session), so this secret gates it: the poll refuses every request
# when this is unset rather than letting anyone drive it, and the scheduler must send the same
# value in an `x-poll-secret` header. Generate one per deployment:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# See docs/deployment/hosted-email.md for the scheduler setup.
INBOUND_POLL_SECRET=""
