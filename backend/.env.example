# Copy to backend/.env.
#
# These defaults match the disposable PostgreSQL container in docker-compose.yml at the
# repo root — run `npm run db:up` and they work as-is. Port 55432 leaves any PostgreSQL
# already installed on your machine untouched.
#
# The development database and the test database MUST be different. The test harness
# truncates every table between tests, so pointing DATABASE_URL and TEST_DATABASE_URL at
# the same database will wipe your development data every time you run the suite.

DATABASE_URL="postgresql://erp:erp_local_dev@localhost:55432/erp_dev?schema=public"
# DIRECT_URL is required when using connection poolers (e.g. Supabase PgBouncer/Supavisor on port 6543) for Prisma migrations (port 5432)
DIRECT_URL="postgresql://erp:erp_local_dev@localhost:55432/erp_dev?schema=public"
TEST_DATABASE_URL="postgresql://erp:erp_local_dev@localhost:55432/erp_test?schema=public"

PORT=3000

# Allowed CORS origins for production when backend and frontend are hosted separately.
# Example: CORS_ORIGIN="https://your-app.vercel.app"
CORS_ORIGIN=""

# Signs every session token. Must be at least 32 characters and secret to the deployment.
#
# This value is fine for local development and for CI, and is worthless anywhere else —
# it is committed to the repository, so anyone can forge a token with it. Generate a real
# one per deployment:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# There is no default in code on purpose. A default would mean every deployment that
# forgot to set this shared one publicly-known signing key.
SESSION_SECRET="local-development-only-not-a-secret-0123456789abcdef"

# Signing in with Google. Both are read from the Google Cloud project's OAuth client; there
# are no fallbacks in the code, so an unset pair makes the Google button answer "not
# configured" rather than authenticate against somebody else's project.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must be registered in that project as an authorised redirect URI, character for character.
# Defaults to http://localhost:<PORT>/api/auth/google/callback when unset.
GOOGLE_AUTH_REDIRECT_URI=""
# The separate callback the CRM mailbox connection uses. A different route, so a different
# setting — one value could only ever point at one of the two flows.
GOOGLE_REDIRECT_URI=""

# The deployment's own outgoing mail - the fallback for a company that has not set its own
# on the Company mail screen, and the only mail available outside company scope (password
# reset runs for somebody who is not signed in, so there is no company to read settings for).
#
# Left empty on purpose: with no SMTP_HOST the server logs messages in development and
# refuses to send in production, rather than reporting success it has no basis for. A real
# host here would make a fresh clone try to send through somebody else's server.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
