// Prisma schema.
//
// Ticket 06 splits this per module so each module's models sit beside its code. Until then
// the models are grouped by owning module here, and ownership is declared in the module's
// manifest — which is what the build already checks migration order against.
//
// Migrations create schema only. They never insert rows — the running application seeds
// no data, ever. The first company and the first user are created through the sign-up
// screen, and owner status is derived from that act rather than from a seeded role row.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── identity ───────────────────────────────────────────────────────────────────────
// Owned by the identity module. See backend/src/modules/identity.

/// The tenant. Every business table in every later module carries a reference to one of
/// these; ticket 03 makes that scoping automatic rather than remembered.
model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// `core`, `enterprise` or `custom` — see `@erp/shared`'s `ModuleTier`. Every company starts
  /// at `core`; there is no self-serve upgrade in this system yet, so nothing here writes a
  /// different value on sign-up. `AccessGuard` reads it fresh on every request rather than
  /// caching it anywhere, which is what makes changing it take effect without a restart.
  tier      String   @default("core")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The user who created the company, and therefore its owner. Nullable only because the
  /// company row is written a moment before the user row inside the sign-up transaction —
  /// there is no committed state in which a company has no owner. Storing the relationship
  /// rather than a flag is what makes ownership derived from creation: it cannot be granted
  /// by inserting a row, only by having been the one who signed up.
  ownerUserId String? @unique @map("owner_user_id") @db.Uuid
  owner       User?   @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  /// How this company's own mail leaves the building: invitations, password resets, anything
  /// the system sends on its own behalf. Null throughout means the deployment's configured
  /// mail is used instead - see platform/mail. The password is encrypted, never as typed.
  mailFromAddress String? @map("mail_from_address")
  mailFromName    String? @map("mail_from_name")
  mailSmtpHost     String?  @map("mail_smtp_host")
  mailSmtpPort     Int?     @map("mail_smtp_port")
  mailSmtpSecure   Boolean? @map("mail_smtp_secure")
  mailSmtpUsername String?  @map("mail_smtp_username")
  mailSmtpPassword String?  @map("mail_smtp_password")

  users            User[]            @relation("CompanyMembers")
  inventorySetting InventorySetting?

  @@map("companies")
}

/// A person, belonging to exactly one company. Access is bounded by employment, so there is
/// no cross-company membership and no user without a company.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  /// Unique across the system rather than per company: sign-in is an email and a password
  /// with no company selector, so a shared address would make the account ambiguous.
  email        String   @unique
  /// scrypt, salted per user. The plaintext is never stored and never recoverable.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company      Company  @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: Cascade)
  /// Back-reference for the ownership relation above. At most one company points here.
  ownedCompany   Company?        @relation("CompanyOwner")
  sessions       Session[]
  userRoles      UserRole[]
  passwordResets PasswordReset[]

  @@index([companyId])
  @@map("users")
}

/// A signed-in period. The token handed to the client names one of these, so signing out is
/// a fact the server holds rather than a request the client is trusted to honour — a bare
/// token could not be withdrawn before it expired.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A named set of permissions, held by however many people a company assigns it to.
///
/// Permissions live in their own table (`RolePermission`) rather than an array column, the
/// same shape `PartyRole` already uses for the one other multi-valued relation in this schema
/// — a join table is a query and a foreign key, an array is neither.
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  userRoles   UserRole[]
  invitations Invitation[]

  /// One name per company. Two roles both called 'Stock clerk' would leave whoever assigns
  /// them unable to say which is meant.
  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

/// One permission a role grants, `<module>:<resource>:<action>`. No table of permitted values:
/// a module introduces one by declaring it in its manifest, and this table only ever names
/// strings some manifest already owns — checked by the conformance pack, not by a foreign key,
/// because the set changes with the modules installed.
model RolePermission {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  permission String
  createdAt  DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// Holding a permission twice is not a different fact from holding it once.
  @@unique([roleId, permission])
  @@index([companyId])
  @@map("role_permissions")
}

/// One role held by one person. A person may hold several; their permissions are the union.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict, deliberately: a role assigned to somebody cannot be deleted out from under
  /// them. The service translates the constraint violation into a clear refusal rather than
  /// checking first — the same shape `HrmService.removeEmployee` already uses for pay history.
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([companyId])
  @@index([companyId, userId])
  @@map("user_roles")
}

/// A colleague invited but not yet signed up. `id` is the token itself — an unguessable UUID
/// looked up directly, exactly the precedent `Session` already sets, rather than a second
/// hashing scheme invented for one more bearer credential.
model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  email       String
  /// Granted the moment the invitation is accepted. Nullable — an invitation need not start
  /// anyone with a role — and `SetNull` rather than `Restrict`: a role deleted after somebody
  /// was invited with it should not block their acceptance, only leave them roleless until
  /// somebody assigns one.
  roleId      String?   @map("role_id") @db.Uuid
  invitedById String    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  role Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([email])
  @@map("invitations")
}

/// A password reset in progress. `id` is the token, as with `Invitation` and `Session`.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// ─── parties ────────────────────────────────────────────────────────────────────────
// Owned by the parties module. See backend/src/modules/parties.
//
// One address book for the whole system. The same record is a customer to Sales, a supplier
// to Purchase and an employee contact to HRM, which is the whole reason it is one Core
// module rather than four private address books that quietly disagree about an address.
//
// As with hrm, `companyId` is a plain column and there is no foreign key to `companies`:
// keys stay inside a module, and scoping is the tenancy extension's rather than the
// schema's. Every key below points at another parties table.

/// A person or an organisation the business deals with.
///
/// Nothing here says what the party is *for*. That is what roles are, and they are a table
/// of their own precisely so that a module introducing a role does not change this one.
model Party {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// `person` or `organisation`. Not an enum, because the values are part of the wire
  /// contract both workspaces bind to, and a Postgres enum would make adding one a
  /// migration in a system whose whole point is that the set does not grow.
  kind String
  /// A person's full name or an organisation's registered name — one column, because a
  /// search box searches for whatever the user calls them.
  name  String
  email String?
  phone String?

  /// `active`, `inactive` or `merged`. Deactivating rather than deleting is what keeps a
  /// three-year-old order intelligible; `merged` is set by merging and never by a caller.
  status String @default("active")

  /// The organisation a person belongs to. Self-referential, and null for an organisation:
  /// an organisation inside another is a group structure, which is not this ticket's.
  organisationId String? @map("organisation_id") @db.Uuid

  /// Set when this party turned out to be a duplicate of another.
  ///
  /// The row stays rather than being deleted, and this is what makes "history stays intact"
  /// true rather than aspirational: an order in some later module still names this id, and
  /// following the pointer answers with the party that survived instead of nothing at all.
  mergedIntoId String? @map("merged_into_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organisation Party?  @relation("PartyMembership", fields: [organisationId], references: [id], onDelete: SetNull)
  members      Party[] @relation("PartyMembership")
  mergedInto   Party?  @relation("PartyMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Party[] @relation("PartyMerge")

  roles     PartyRole[]
  addresses PartyAddress[]

  @@index([companyId])
  /// The list's default order, within a company — the `(company_id, <default sort>)` shape
  /// every list endpoint's default sort wants, so that offset paging is an index walk.
  @@index([companyId, name])
  @@index([organisationId])
  @@map("parties")
}

/// One role a party holds: `customer`, `supplier`, `employee-contact`, or whatever a module
/// introduces next.
///
/// A row rather than a column, and no table of permitted roles anywhere. That is the whole
/// of "adding a role does not require changing the Parties module": a role exists because
/// somebody gave it to somebody. A join table would need a `roles` table, and a `roles`
/// table would need a module that owns which roles exist — which is a decision Sales and
/// Purchase should each be able to make alone.
model PartyRole {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  partyId   String   @map("party_id") @db.Uuid
  role      String
  createdAt DateTime @default(now()) @map("created_at")

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  /// Holding a role twice is not a different fact from holding it once.
  @@unique([partyId, role])
  @@index([companyId])
  /// Answers "which roles are in use here?" without reading the parties themselves.
  @@index([companyId, role])
  @@map("party_roles")
}

/// Somewhere a party can be written to or delivered to.
///
/// Several per party, because a supplier's registered office and its warehouse are both
/// real and neither is the other. Deliberately unstructured beyond the fields below: address
/// formats differ by country and a schema that insisted on a county would be wrong in most
/// of the world.
model PartyAddress {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  partyId   String  @map("party_id") @db.Uuid
  /// What this address is for, in the user's own words: 'Registered office', 'Delivery'.
  label     String
  line1     String  @map("line1")
  line2     String? @map("line2")
  city      String
  postcode  String
  country   String
  /// The one used when nothing says otherwise. At most one per party, kept so by the module.
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([partyId])
  @@map("party_addresses")
}

// ─── hrm ────────────────────────────────────────────────────────────────────────────
// Owned by the hrm module. See backend/src/modules/hrm.
//
// The shape stub. It is here to stop the foundation hardening around inventory: it is
// shaped like payroll rather than like stock — a periodic calculation over a date range
// instead of a reaction to an event, a sensitive personal field, and records that can
// never be edited once written.
//
// `companyId` is a plain column with no foreign key to `companies`. Foreign keys stay
// inside a module; a key across the module boundary would make the data model disagree
// with the module graph, and would tie hrm's schema to identity's. Scoping is enforced by
// the tenancy extension, which reads the column and does not care whether it is a key —
// see backend/src/platform/tenancy and ADR 0003.

/// A person on the payroll. Deliberately hrm's own record rather than a reference to
/// identity's `User`: not everybody paid is a system user, and the stub must not need a
/// cross-module dependency to demonstrate the shape.
model Employee {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  /// The sensitive personal field, and the reason the stub earns its place in ticket 03:
  /// it is company-scoped *and* further restricted, which is a case inventory never
  /// produces. Restricted by the `hrm:pay:read` grant — see platform/tenancy.
  annualSalary Decimal @map("annual_salary") @db.Decimal(14, 2)
  /// The restricted *record*, as against the restricted field above. An employee whose whole
  /// file is confidential — a director's, typically — is filtered out of every query for a
  /// caller without `hrm:employees:read-confidential`, so it is unreachable by its own
  /// identifier rather than merely absent from a list. See platform/tenancy.
  confidential Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  payRunLines PayRunLine[]

  @@index([companyId])
  /// The employee list's default order, within a company.
  ///
  /// Paging is offset-based (ADR 0004), and an offset is only cheap when the sort it walks is
  /// an index walk — otherwise the database sorts the whole company's rows to answer for
  /// twenty-five of them. Every list endpoint's default sort wants one of these; this is the
  /// first, and the pattern is `(company_id, <default sort column>)` because the company
  /// filter is always present.
  @@index([companyId, name])
  @@map("employees")
}

/// A pay run: the calculation for one period, done once. Immutable — declared so in
/// platform/tenancy/company-owned.ts, which refuses update and delete outright, because a
/// payroll record that can be edited after the fact is not a payroll record.
model PayRun {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  periodStart  DateTime @map("period_start") @db.Date
  periodEnd    DateTime @map("period_end") @db.Date
  calculatedAt DateTime @default(now()) @map("calculated_at")

  lines PayRunLine[]

  /// One run per period per company. A second attempt is a mistake, not a recalculation:
  /// the first is immutable, so there would be two answers for one period.
  @@unique([companyId, periodStart, periodEnd])
  @@index([companyId])
  @@map("pay_runs")
}

/// What one employee was paid for one period. Immutable for the same reason as its run.
model PayRunLine {
  id         String  @id @default(uuid()) @db.Uuid
  companyId  String  @map("company_id") @db.Uuid
  payRunId   String  @map("pay_run_id") @db.Uuid
  employeeId String  @map("employee_id") @db.Uuid
  /// Sensitive, like the salary it is derived from, and restricted by the same grant.
  /// Numeric rather than a floating-point column: money is exact or it is wrong.
  grossPay   Decimal @map("gross_pay") @db.Decimal(14, 2)

  payRun   PayRun   @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payRunId, employeeId])
  @@index([companyId])
  @@map("pay_run_lines")
}

// ─── products ──────────────────────────────────────────────────────────────────────
// Owned by the products module. See backend/src/modules/products.
//
// The product master, beneath inventory rather than inside it, so that Sales, Purchase,
// Manufacturing and E-commerce depend on products rather than on stock movements and
// locations in order to name the thing they are dealing in.
//
// As everywhere else, `companyId` is a plain column with no foreign key to `companies`:
// keys stay inside a module, and scoping is the tenancy extension's rather than the schema's.
// `product_suppliers.party_id` is the same rule seen from the other side — it points at a
// row parties owns, and there is deliberately no key to it. The reference is resolved through
// `PartyDirectory`, which is a contract, and a foreign key would be a second dependency the
// module graph does not describe.

/// A set of units that measure the same thing: weight, volume, time.
///
/// The group is what makes conversion meaningful and what makes it *refusable*: kilograms and
/// grams convert because somebody said they measure the same thing, and kilograms and hours
/// do not because nobody could.
model UnitGroup {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  units UnitOfMeasure[]

  /// One group per name per company. Two 'Weight' groups would be two sets of units that
  /// cannot convert to each other while claiming to measure the same thing.
  @@unique([companyId, name])
  @@index([companyId])
  @@map("unit_groups")
}

/// How much of something there is measured in — a kilogram, an hour, an each.
///
/// Nothing is seeded, here least of all. A business that deals in metres and one that deals in
/// pallets should not both start with a list somebody else guessed at, and a seeded unit is a
/// row nobody chose that every later movement is measured in.
model UnitOfMeasure {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// The symbol as the user types it — `kg`, `kWh`, `each`. Case is preserved, because there
  /// is no normalisation that is right for all three. Unique within the company.
  code String
  /// What it is called in full: 'Kilogram'.
  name String

  /// The group it converts within, or none.
  groupId String? @map("group_id") @db.Uuid

  /// How many of the group's *base* unit one of these is.
  ///
  /// The base unit is simply the one whose ratio is 1 — there is no pointer to it, and there
  /// does not need to be: converting is `amount × from.ratio ÷ to.ratio`, which never names
  /// the base and cannot disagree with a column claiming which unit it is.
  ///
  /// Twelve decimal places because a ratio is a definition rather than a measurement: an ounce
  /// is 0.028349523125 kilograms exactly, and rounding a definition makes every quantity
  /// derived from it slightly wrong forever.
  ratio Decimal @default(1) @db.Decimal(24, 12)

  /// `active` or `inactive`. A unit in use is never deleted — every product measured in it
  /// and every movement recorded in it would be measured in nothing.
  status String @default("active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group    UnitGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  products Product[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([groupId])
  @@map("units_of_measure")
}

/// A thing the business deals in.
model Product {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// The SKU, upper case and unique within the company. Unique *within* the company and not
  /// across it: two businesses both calling something `WIDGET-1` is not a collision, and a
  /// global constraint would make one of them rename their catalogue because of the other.
  code String
  name String

  unitId String @map("unit_id") @db.Uuid

  /// What one of these costs, for stock to be valued at. Numeric rather than floating point:
  /// money is exact or it is wrong. Null until somebody records one — a cost of zero is a
  /// claim, and "nobody has said" is not that claim.
  cost Decimal? @db.Decimal(14, 2)

  /// Whether stock of it is counted. A delivery charge and an hour of consultancy are
  /// products with prices and no shelf.
  stockable Boolean @default(true)

  /// `active` or `inactive`. Deactivating rather than deleting is what keeps three years of
  /// movements, orders and valuations naming this row intelligible.
  status String @default("active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  unit      UnitOfMeasure     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  suppliers ProductSupplier[]

  @@unique([companyId, code])
  @@index([companyId])
  /// The list's default order, within a company — the `(company_id, <default sort>)` shape
  /// every list endpoint's default sort wants, so that offset paging is an index walk.
  @@index([companyId, code])
  @@index([companyId, name])
  @@index([unitId])
  @@map("products")
}

/// Somebody this product is bought from.
///
/// A row rather than a column on the product, because a product has several suppliers and a
/// supplier supplies several products. `partyId` names a row in the address book and is
/// resolved through the Parties contract; products never reads that table.
model ProductSupplier {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  partyId   String   @map("party_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Supplying something twice is not a different fact from supplying it once.
  @@unique([productId, partyId])
  @@index([companyId])
  @@index([partyId])
  @@map("product_suppliers")
}

// ─── warranties ────────────────────────────────────────────────────────────────────
// Owned by the warranties module. See backend/src/modules/warranties.
//
// The add-on shape stub: Custom tier, depending on and extending `products` through its
// public contract rather than editing it. As everywhere else, `companyId` is a plain column
// with no foreign key to `companies` — keys stay inside a module, and scoping is the tenancy
// extension's rather than the schema's. `productId` is the same rule seen from the other
// side: it points at a row `products` owns, and there is deliberately no key to it. The
// reference is resolved through `ProductCatalogue`, which is a contract, and a foreign key
// would be a second dependency the module graph does not describe.

/// A warranty period recorded against a product.
model Warranty {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  productId String  @map("product_id") @db.Uuid
  /// How many months the warranty covers, from whenever the business considers it to start.
  months    Int
  notes     String?

  /// `active` or `inactive`. Deactivating rather than deleting is what keeps a voided
  /// warranty's history intelligible.
  status String @default("active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  /// The list's default order, within a company — the `(company_id, <default sort>)` shape
  /// every list endpoint's default sort wants, so that offset paging is an index walk.
  @@index([companyId, createdAt])
  @@index([companyId, productId])
  @@map("warranties")
}

// ─── inventory ─────────────────────────────────────────────────────────────────────
// Owned by the inventory module. See backend/src/modules/inventory.
//
// As everywhere else, `companyId` is a plain column with no foreign key to `companies`:
// keys stay inside a module, and scoping is the tenancy extension's rather than the schema's.

/// Somewhere this company keeps things — a warehouse, a van, a bay, a bonded store.
///
/// Flat, with no parent: a bin inside an aisle inside a warehouse is a level every stock
/// figure has to be summed across, and nobody has asked for one. Adding a parent later leaves
/// every row written today still true, which is not something the reverse can claim.
model Location {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// The code people write on a label, upper case and unique within the company. Unique
  /// *within* it and not across it, as a SKU is: two businesses both calling somewhere `WH-1`
  /// is not a collision.
  code String
  name String

  /// `active` or `inactive`. Deactivating rather than deleting is what keeps every movement
  /// ever recorded against this row intelligible.
  status String @default("active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movements StockMovement[]
  levels    StockLevel[]

  @@unique([companyId, code])
  @@index([companyId])
  /// The list's default order, within a company. `(company_id, code)` is already covered by
  /// the unique constraint above — Postgres backs it with an index the default sort walks —
  /// so the only one worth adding is the other order somebody sorts by.
  @@index([companyId, name])
  @@map("locations")
}

/// One thing that moved: the ledger, and the module's reason for existing.
///
/// Append-only, declared so in `platform/tenancy/company-owned.ts`, which refuses update and
/// delete outright rather than leaving it to each service to remember. A stock ledger that can
/// be edited after the fact is not a ledger — it is a table of current opinions, and the
/// accounting entries derived from it would have nothing to reconcile against. A mistake is
/// corrected by recording another movement (ticket 11's reversal), never by rewriting this one.
///
/// `productId` points at a row `products` owns, and `recordedById` at one `identity` owns.
/// There is deliberately no foreign key to either: keys stay inside a module, and a key across
/// the boundary would make the data model disagree with the module graph. The product is
/// resolved through `ProductCatalogue`, which is a contract; the user is never resolved at all,
/// because their name is frozen onto the row below. `locationId` is the one reference that
/// *does* get a key, because a location is inventory's own.
model StockMovement {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// `receipt` or `issue`. Not an enum, for the reason every status column here gives: the
  /// values are part of the wire contract both workspaces bind to, and tickets 10 and 11 add
  /// more of them.
  kind String

  /// What a journal entry posted from this would do — `stock-in` or `stock-out`. The whole of
  /// the accounting seam, as a column: see the contract's `MOVEMENT_CLASSIFICATIONS` for why it
  /// is this and not an account code.
  classification String

  productId  String @map("product_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  /// Signed: positive for a receipt, negative for an issue. Signed rather than an unsigned
  /// magnitude beside a direction column, because the two would be two ways to say one thing
  /// and summing the ledger would have to consult both. `numeric` and never floating point,
  /// at the scale `Quantity` is defined at.
  quantity Decimal @db.Decimal(24, 6)

  /// What the quantity was measured in — the symbol itself, frozen at the moment of recording.
  ///
  /// Text rather than a reference to `units_of_measure`, and that is the same decision
  /// `recordedByName` below makes. A quantity without its unit is not a number anybody can act
  /// on, so "5" has to still read as "5 kg" in three years — after the product has been
  /// re-measured in grams, and whether or not the unit row still exists. Storing the identifier
  /// would leave this module needing a way to turn one back into a symbol, which is a question
  /// `ProductCatalogue` does not answer and should not have to: it is a contract about products,
  /// not a dictionary of units.
  ///
  /// It is always the product's unit at the time of recording, which is what keeps the running
  /// total below a sum of like with like.
  unitCode String @map("unit_code")

  /// What one of these was worth when it moved, and what the movement was worth in total.
  ///
  /// Frozen here rather than recomputed from the product's cost later, which is the difference
  /// between a ledger and a report: the cost of a widget changes, and last April's receipt was
  /// still worth what it was worth last April. Null when the product had no recorded cost —
  /// not zero, because a cost of zero is a claim and "nobody has said" is not that claim.
  unitCost Decimal? @map("unit_cost") @db.Decimal(14, 2)
  /// Signed, matching the quantity, so the ledger's values sum to what the stock is worth.
  /// Ticket 13's valuation is the assertion that they do.
  value    Decimal? @db.Decimal(14, 2)

  /// Reason for an adjustment movement. Null for receipts, issues, and transfers.
  reason             String?
  /// Linked movement transfer identifier for transfers. Null for receipts, issues, and adjustments.
  transferId         String?        @map("transfer_id") @db.Uuid
  /// Identifier of the movement that this entry reverses. Null for original movements.
  reversedMovementId String?        @unique @map("reversed_movement_id") @db.Uuid
  reversedMovement   StockMovement? @relation("MovementReversals", fields: [reversedMovementId], references: [id], onDelete: Restrict)
  reversalMovement   StockMovement? @relation("MovementReversals")

  /// Who did it. No foreign key to `users` — see the note above — and never null: a ledger
  /// entry nobody is accountable for is the one an auditor asks about.
  recordedById String @map("recorded_by_id") @db.Uuid

  /// Their name, as it was at the moment they did it.
  ///
  /// Copied rather than looked up, and this is the one denormalisation in the schema that is
  /// load-bearing rather than a shortcut. Identity's public surface is deliberately empty — a
  /// module asks the platform who is *asking*, and never asks identity who somebody *was* — so
  /// there is no contract through which inventory could resolve this identifier later, by
  /// design rather than by omission.
  ///
  /// It is also simply the right column for a ledger. An audit trail that renamed people
  /// retroactively would report that Ada Okafor recorded a movement under a surname she did not
  /// have that year, and a person who leaves the company should not make three years of history
  /// unreadable. The product's and the location's names are resolved live, deliberately
  /// differently: those label rows that still exist and are still being maintained, and a
  /// reader wants to recognise them by what they are called now.
  recordedByName String @map("recorded_by_name")

  /// When it happened, which for an append-only table is also when the row was written. One
  /// timestamp rather than the usual `createdAt` beside an `occurredAt`, because nothing here
  /// can be back-dated: a movement is recorded as it is made. When something needs to record
  /// stock as of a date it did not happen on, that is a second column and a decision, not a
  /// reinterpretation of this one.
  recordedAt DateTime @default(now()) @map("recorded_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([companyId])
  /// The list's default order, within a company: newest first is what a history screen opens
  /// on, and an offset page of it should be an index walk rather than a sort of the whole
  /// ledger.
  @@index([companyId, recordedAt])
  /// "What has happened to this product?" — the question the product's own history screen asks.
  @@index([companyId, productId, recordedAt])
  @@index([companyId, locationId, recordedAt])
  @@index([companyId, transferId])
  @@map("stock_movements")
}

/// Inventory-specific settings per tenant.
model InventorySetting {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @unique @map("company_id") @db.Uuid
  allowNegativeStock Boolean  @default(false) @map("allow_negative_stock")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("inventory_settings")
}

/// How much of one product is at one location — the running total of the ledger above.
///
/// Derived data, and the only derived data in this schema. It exists because the alternative is
/// summing every movement ever recorded on every screen that shows a stock figure, which is
/// fine for a hundred rows and not for a million. The bargain is that it is written in the same
/// transaction as the movement that changes it and never anywhere else, so the two cannot
/// disagree — ticket 12 hardens that under concurrency, and ticket 12's reconciliation check is
/// what proves it held.
///
/// Mutable, unlike the ledger: a running total is meant to change. That is exactly why the
/// ledger is the record and this is the cache.
model StockLevel {
  id         String @id @default(uuid()) @db.Uuid
  companyId  String @map("company_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  /// Can be negative. Ticket 11 is where a company decides whether it may be — until then the
  /// column permits what the ledger permits, because a constraint here would be a policy
  /// decision made by a migration.
  quantity Decimal @db.Decimal(24, 6)

  updatedAt DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  /// One row per product per place. This is what makes the running total a total rather than a
  /// second ledger: there is nowhere to write a duplicate.
  @@unique([companyId, productId, locationId])
  @@index([companyId])
  /// "What is held here?" — the question a location's stock screen asks, and the one
  /// `LocationsService.productsHeldAt` asks before letting somewhere be deactivated.
  @@index([companyId, locationId])
  @@map("stock_levels")
}

// ─── crm ───────────────────────────────────────────────────────────────────────────
// Owned by the crm module. See backend/src/modules/crm.
//
// As everywhere else, `companyId` is a plain column with no foreign key to `companies`:
// keys stay inside a module, and scoping is the tenancy extension's rather than the schema's.

/// A not-yet-qualified prospect. Its own record, not a `Party` — no address-book entry
/// exists yet, which is exactly what qualifying produces.
model Lead {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  name String

  /// Free text — no `Party` exists yet to hold a real organisation record.
  organisationName String? @map("organisation_name")
  email            String?
  phone            String?

  /// The channel this Lead came through, in the company's own words. A real FK to this
  /// module's own `LeadSource` table — the fixed five-value string this column used to hold
  /// became rows in `20260824040000_lead_organisation`, one set per company, so no company
  /// lost its history and none was seeded with a vocabulary it had not used.
  ///
  /// Nullable, because a fresh company owns no sources and this platform seeds none: a name
  /// heard on a call is captured first and attributed afterwards. `Restrict` is
  /// belt-and-suspenders under `LeadSourcesService`'s own occupancy check.
  sourceId String?     @map("source_id") @db.Uuid
  source   LeadSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  /// `'new' | 'contacted' | 'qualified' | 'disqualified'`.
  status String @default("new")

  /// The status held immediately before disqualification, restored by `reopen`. Null except
  /// while disqualified — stored rather than inferred, so reopening never has to guess.
  priorStatus String? @map("prior_status")

  /// The lead's *primary* owner — a cached convenience, kept equal to the first of `assignees`
  /// (or null when nobody is on it). The full set a lead may now be shared across lives in
  /// `LeadAssignee`; this column is retained so every single-owner read written before leads
  /// could be co-owned — the workspace's "assigned to me", the deals board's reuse of the same
  /// field name, bulk assign — keeps working unchanged. `LeadsService.syncAssignees` is the one
  /// path that writes both, so the two never drift.
  ///
  /// A plain platform `User` reference, no FK. Live and reassignable, unlike an actor-freeze
  /// column: the frontend resolves it by calling identity's `GET /api/identity/users`
  /// directly, because identity's public surface is deliberately empty and no module —
  /// crm included — may depend on it.
  assignedToUserId String? @map("assigned_to_user_id") @db.Uuid

  /// Set once qualification links or creates a `Party`. No FK — resolved through
  /// `PartyDirectory`, parties' public surface.
  partyId String? @map("party_id") @db.Uuid

  /// The swimlane this Lead sits in on the board, if any. `Restrict` rather than `SetNull`:
  /// `LeadGroupsService` refuses to delete an occupied group, so silently emptying a lead's
  /// group would only ever happen on a path that is supposed to be unreachable.
  groupId String?    @map("group_id") @db.Uuid
  group   LeadGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)

  /// Values for this company's `LeadFieldDefinition`s, keyed by definition `key`.
  ///
  /// One JSON column rather than an entity-attribute-value table: the values are read and
  /// written whole, always alongside their Lead, and never joined against. The cost is stated
  /// rather than hidden — a JSON column has no static fields, so custom fields do not take part
  /// in `ListSpec`'s sort/filter grammar. Built-in columns do.
  ///
  /// Keys whose definition has since been archived stay here and still read back. Archiving is
  /// how a company changes its mind without destroying what it already captured.
  customValues Json @default("{}") @map("custom_values")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activities Activity[]
  campaignRecipients CampaignRecipient[]
  attachments LeadAttachment[]
  submissions LeadSubmission[]
  emailSends LeadEmailSend[]
  assignees LeadAssignee[]

  @@index([companyId])
  @@index([companyId, groupId])
  @@index([companyId, sourceId])
  /// The list's default order, within a company — the `(company_id, <default sort>)` shape
  /// every list endpoint's default sort wants, so that offset paging is an index walk.
  @@index([companyId, name])
  /// The source-performance dashboard's cohort window, per company.
  @@index([companyId, createdAt])
  @@map("leads")
}

/// A file attachment uploaded against a Lead.
model LeadAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  leadId     String   @map("lead_id") @db.Uuid
  filename   String
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  storageKey String   @map("storage_key")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, leadId])
  @@map("lead_attachments")
}

/// One person a Lead is assigned to. A Lead may now be worked by several people at once, so
/// ownership is a set of rows rather than a single column — `Lead.assignedToUserId` is kept as
/// the primary (the first of these) for the single-owner reads that predate co-ownership.
///
/// `userId` is a plain platform `User` reference with no FK, the same policy `Lead.assignedToUserId`
/// documents: identity owns no relation into this module and is resolved through its public user
/// list. `@@unique([leadId, userId])` makes assigning the same person twice a no-op rather than a
/// second row, and the `(company_id, user_id)` index answers "which leads is this person on?" —
/// the shape the board's owner filter walks through `LEAD_LIST`'s `via: { relation: 'assignees' }`.
model LeadAssignee {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, userId])
  @@index([companyId])
  @@index([companyId, leadId])
  @@index([companyId, userId])
  @@map("lead_assignees")
}

/// One capture-form response tied to a Lead.
///
/// A lead may accumulate several: a second response from a known lead appends rather than being
/// dropped, so the picture builds up. `rawPayload` holds every answer as it arrived — the ones
/// no field maps included, which is what stops a survey answer being lost because nobody had
/// defined a field for it yet. `mappedFields` records answer key → the Lead field it fed, so
/// which answers were mapped stays answerable even when the two are named differently.
model LeadSubmission {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  leadId          String   @map("lead_id") @db.Uuid
  /// Null once the capture source it came through is deleted; the response itself outlives it.
  captureSourceId String?  @map("capture_source_id") @db.Uuid
  /// The form's name at the time of submission. A snapshot, because sources get renamed.
  formName        String   @map("form_name")
  rawPayload      Json     @map("raw_payload")
  mappedFields    Json     @map("mapped_fields")
  submittedAt     DateTime @default(now()) @map("submitted_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, leadId])
  @@map("lead_submissions")
}

/// One 1:1 email sent to a Lead, and whatever its tracking pixel has since reported.
///
/// The same shape `CampaignRecipient` carries for campaign opens, for the same reason: an open
/// is a token being fetched, so the token has to be stored somewhere it can be looked up
/// without a session. `openCount` climbs on every fetch; `openedAt` is set once, and it is the
/// first open alone that notifies anyone — Apple Mail Privacy Protection pre-fetches images, so
/// a notification per fetch would be noise rather than news.
model LeadEmailSend {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  leadId       String    @map("lead_id") @db.Uuid
  /// The Correspondence entry this send produced on the Timeline.
  activityId   String?   @map("activity_id") @db.Uuid
  /// The `📬` Audit event the first open produced. Kept so a later open can raise the count it
  /// shows rather than adding a second entry saying the same thing again.
  openActivityId String? @map("open_activity_id") @db.Uuid
  sentByUserId String    @map("sent_by_user_id") @db.Uuid
  subject      String
  openToken    String    @unique @default(uuid()) @map("open_token")
  sentAt       DateTime  @default(now()) @map("sent_at")
  openedAt     DateTime? @map("opened_at")
  openCount    Int       @default(0) @map("open_count")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, leadId])
  @@map("lead_email_sends")
}

/// A company's own swimlanes on the Leads board.
///
/// No seed data, and nothing is provisioned on read: a fresh company has zero groups and the
/// board's empty state is "create your first group", the same discipline `Stage` holds. `order`
/// is renumbered across the company on every move, for the reason `Stage.order` documents.
model LeadGroup {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  color     String   @default("#579bfc")
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@index([companyId])
  @@index([companyId, order])
  @@map("lead_groups")
}

/// A company's own name for a channel a Lead can arrive through.
///
/// Replaces the fixed `'referral' | 'inbound' | ...` string `Lead.source` used to hold, so that
/// "which channel is working" is answerable in the words the company actually uses. Renaming is
/// unrestricted — the id is what Leads point at, so fixing a label is never a data migration.
model LeadSource {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@index([companyId])
  @@index([companyId, order])
  @@map("lead_sources")
}

/// One status on a company's Leads board — what it is called, the colour it shows in, and,
/// for the ones a company added itself, the fact that it exists at all.
///
/// Two kinds of row live here. A row for one of the four `LEAD_STATUSES` is cosmetic: the
/// lifecycle `qualify`/`disqualify`/`reopen` act on and that `WorkflowRule.triggerConfig` names
/// is unchanged by renaming `new` to "Fresh", and a company that has customised nothing has no
/// such row — reads fill in the contract's defaults, so a caller always sees at least four.
///
/// An `isCustom` row is a stage of the company's own, and is the only kind that can be created
/// or deleted. It is settable by an ordinary edit, exactly like `new` and `contacted`, and is
/// never terminal: `qualified` and `disqualified` remain the only states the Party link is
/// attached to, so nothing in the lifecycle has to recognise a status it has never heard of.
model LeadStatusLabel {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  /// One of `LEAD_STATUSES`, or a key derived from a custom status's label. Text, not a
  /// Postgres enum, matching `Lead.status` itself.
  status    String
  label     String
  color     String
  /// True for a status this company added. Built-in rows are captions and cannot be deleted.
  isCustom  Boolean  @default(false) @map("is_custom")
  /// Where the status sits in the picker. The built-ins hold 0–3; custom statuses follow.
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// At most one row per status per company — an upsert target for the built-ins, and the
  /// guard that stops two custom statuses colliding on one derived key.
  @@unique([companyId, status])
  @@index([companyId])
  @@map("lead_status_labels")
}

/// One custom field a company has defined on its Leads. The values live on `Lead.customValues`.
model LeadFieldDefinition {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// Derived once from `label` at creation and never written again. A rename changes the label
  /// only, so values already stored under this key on some Lead's `customValues` never orphan.
  key String

  label String

  /// One of `LEAD_FIELD_TYPES`. Not settable after creation — see `UpdateLeadFieldRequest`.
  type String

  /// A JSON string array for `select` and `multiselect`, `[]` for every other type.
  options Json @default("[]")

  required Boolean @default(false)

  order Int

  /// Set when the field is archived. Archived fields are not offered, not required, and not
  /// validated against — but every value already captured under this key still reads back.
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, key])
  @@index([companyId])
  @@index([companyId, order])
  @@map("lead_field_definitions")
}

/// A record of a spreadsheet import batch committed by a user.
model LeadImport {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid

  filename         String
  rowCount         Int      @map("row_count")
  acceptedCount    Int      @map("accepted_count")

  importedByUserId String   @map("imported_by_user_id") @db.Uuid
  importedByName   String   @map("imported_by_name")

  createdAt        DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("lead_imports")
}

/// An intake channel for leads — a published web form or third-party webhook URL.
model CaptureSource {
  id                      String    @id @default(uuid()) @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  kind                    String
  name                    String
  token                   String    @unique
  enabled                 Boolean   @default(true)
  config                  Json
  defaultSourceId         String?   @map("default_source_id") @db.Uuid
  defaultGroupId          String?   @map("default_group_id") @db.Uuid
  defaultAssignedToUserId String?   @map("default_assigned_to_user_id") @db.Uuid
  submissionCount         Int       @default(0) @map("submission_count")
  lastSubmissionAt        DateTime? @map("last_submission_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("capture_sources")
}

/// A company's own pipeline, one row per column on the deals board.
///
/// No seed data — a fresh company has zero Stages, and the board's empty state is "create your
/// first stage" (mirroring Expenses' Category discipline). `deleteStage` refuses to remove one
/// still holding Deals; `changeStage` refuses a second `'won'` or a second `'lost'` per company.
/// Both are cross-row invariants, so both are enforced in `StagesService` rather than here.
model Stage {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  name String

  /// Board position within the company. Not a `@@unique([companyId, order])` — a reorder is a
  /// swap between two rows, and an immediate (non-deferrable) unique index would refuse the
  /// first of the two writes before the second could land. `StagesService` renumbers every
  /// Stage in the company to consecutive integers on every reorder instead, which is what
  /// actually keeps this column unique — the same "cross-row invariant, application layer"
  /// reasoning the spec gives for `outcome` below, applied to the other one that needs it.
  order Int

  /// `'won' | 'lost' | null` — null for every in-flight stage. At most one Stage may hold each
  /// of `'won'`/`'lost'` per company: a cross-row invariant Postgres cannot express as a simple
  /// constraint, so `StagesService` enforces it instead.
  outcome String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deals Deal[]

  @@index([companyId])
  /// The list's default order, within a company — the `(company_id, <default sort>)` shape
  /// every list endpoint's default sort wants, so that offset paging is an index walk.
  @@index([companyId, order])
  @@map("stages")
}

/// A sale in progress against a real `Party`, moving between Stages on the board.
///
/// Landing on a Stage whose `outcome` is `'won'` or `'lost'` is how a Deal closes — there is no
/// separate close endpoint, and no `outcome`/`status` column here to drift from the Stage's own:
/// `DealsService` always reads it off the Stage a Deal currently sits in.
model Deal {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// Mandatory. No FK — resolved through `PartyDirectory`, parties' public surface, exactly as
  /// `Lead.partyId` is.
  partyId String @map("party_id") @db.Uuid

  /// Mandatory, and — unlike `partyId` — a real FK: a Stage is this module's own table, so
  /// nothing stops the key from crossing the boundary the way one to `parties` would.
  /// `onDelete: Restrict` is belt-and-suspenders under `StagesService`'s own occupancy check,
  /// matching `Product.unitId`'s and `StockMovement.locationId`'s FKs within their own modules.
  stageId String @map("stage_id") @db.Uuid
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Restrict)

  name String

  /// This platform's exact `MoneyValue`, stored the way `Product.cost` is: a bare `numeric`
  /// column and no currency column beside it, because currency is fixed to `DEFAULT_CURRENCY`
  /// platform-wide (ADR 0004) rather than chosen per Deal.
  amount Decimal @db.Decimal(14, 2)

  expectedCloseDate DateTime? @map("expected_close_date") @db.Date

  /// A plain platform User reference, no FK. Live and reassignable, exactly like
  /// `Lead.assignedToUserId` — the frontend resolves it via `GET /api/identity/users`, because
  /// identity's public surface is deliberately empty and no module may depend on it.
  assignedToUserId String? @map("assigned_to_user_id") @db.Uuid

  /// Optional and informational only — traces a win back to the Lead it came from, without ever
  /// requiring one. No FK: qualifying a Lead never creates a Deal, so this is always a separate,
  /// explicit act, and nothing here assumes the named Lead still exists.
  originLeadId String? @map("origin_lead_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activities Activity[]

  @@index([companyId])
  @@index([companyId, name])
  @@index([stageId])
  @@map("deals")
}

/// An interaction, note or task logged against a Lead, Deal or Party.
model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  type      String
  notes     String
  occurredAt DateTime @default(now()) @map("occurred_at")
  dueAt     DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdByName   String @map("created_by_name")

  leadId  String? @map("lead_id") @db.Uuid
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  dealId  String? @map("deal_id") @db.Uuid
  deal    Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  partyId String? @map("party_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([companyId, leadId, occurredAt])
  @@index([companyId, dealId, occurredAt])
  @@index([companyId, partyId, occurredAt])
  @@map("activities")
}

/// Event-triggered no-code automation rules for CRM events (Deal stage changed, Lead status changed).
model WorkflowRule {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  name          String
  triggerType   String   @map("trigger_type")
  triggerConfig Json?    @map("trigger_config")
  actionType    String   @map("action_type")
  actionConfig  Json     @map("action_config")
  enabled       Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("workflow_rules")
}

/// In-app notification record generated by notify_user workflow rule action or system events.
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([companyId, userId, read])
  @@map("notifications")
}

/// Mailbox connection for salesperson outreach (Gmail / Outlook).
model MailboxConnection {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  provider     String
  emailAddress String   @map("email_address")
  displayName  String   @map("display_name")
  status       String
  /// OAuth providers only. Null for an SMTP mailbox, which authenticates per send.
  accessToken  String?  @map("access_token")
  refreshToken String?  @map("refresh_token")
  /// When `accessToken` stops being accepted, so it can be refreshed before a send fails.
  tokenExpiresAt DateTime? @map("token_expires_at")

  /// SMTP mailboxes only. The password is encrypted at rest - see crm/mailbox-secrets.ts.
  smtpHost     String?  @map("smtp_host")
  smtpPort     Int?     @map("smtp_port")
  smtpSecure   Boolean? @map("smtp_secure")
  smtpUsername String?  @map("smtp_username")
  smtpPassword String?  @map("smtp_password")

  connectedAt  DateTime @default(now()) @map("connected_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([companyId, userId, provider])
  @@index([companyId])
  @@map("mailbox_connections")
}

/// Short-lived OAuth authorization state token.
model MailboxAuthState {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String
  stateToken String   @unique @map("state_token")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("mailbox_auth_states")
}

/// Reusable email template with dynamic placeholders.
model EmailTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  name            String
  subject         String
  body            String
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("email_templates")
}

/// An email campaign targeted at a segment of leads.
model Campaign {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  name                String
  status              String   @default("draft")
  mailboxConnectionId String   @map("mailbox_connection_id") @db.Uuid
  templateId          String   @map("template_id") @db.Uuid
  segmentConfig       Json     @default("{}") @map("segment_config")
  totalLeadsCount     Int      @default(0) @map("total_leads_count")
  excludedCount       Int      @default(0) @map("excluded_count")
  sentCount           Int      @default(0) @map("sent_count")
  openedCount         Int      @default(0) @map("opened_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipients CampaignRecipient[]

  @@index([companyId])
  @@map("campaigns")
}

/// A recipient in a campaign cohort, materialized from a lead segment.
model CampaignRecipient {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  campaignId    String    @map("campaign_id") @db.Uuid
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId        String    @map("lead_id") @db.Uuid
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  emailAddress  String    @map("email_address")
  status        String    @default("pending")
  excludeReason String?   @map("exclude_reason")
  sentAt        DateTime? @map("sent_at")
  openToken     String    @unique @default(uuid()) @map("open_token")
  openedAt      DateTime? @map("opened_at")
  openCount     Int       @default(0) @map("open_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([campaignId])
  @@index([leadId])
  @@map("campaign_recipients")
}

/// Permanent record of an email address that unsubscribed from a company's campaign emails.
model Unsubscribe {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  emailAddress   String   @map("email_address")
  campaignId     String?  @map("campaign_id") @db.Uuid
  unsubscribedAt DateTime @default(now()) @map("unsubscribed_at")

  @@unique([companyId, emailAddress])
  @@index([companyId])
  @@index([emailAddress])
  @@map("unsubscribes")
}





