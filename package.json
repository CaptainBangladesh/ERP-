{
  "name": "erp",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages",
    "backend",
    "application"
  ],
  "scripts": {
    "predev": "npm run build --workspace packages",
    "dev": "concurrently -n backend,app -c blue,magenta \"npm:dev:backend\" \"npm:dev:app\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:app": "npm run dev --workspace application",
    "start": "node backend/scripts/start.mjs",
    "build": "npm run build --workspace packages && concurrently -n backend,app -c blue,magenta \"npm run build --workspace backend\" \"npm run build --workspace application\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:modules": "npm run check:modules --workspace backend",
    "check:tenancy": "npm run check:tenancy --workspace backend",
    "check:conformance": "npm run check:conformance --workspace backend",
    "new:module": "npm run new:module --workspace backend --",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test --workspace backend",
    "test:app": "npm run test --workspace application",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:reset": "npm run db:reset --workspace backend"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "nodemailer": "^6.9.16"
  }
}
